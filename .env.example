# The only required setting:
GITHUB_USERNAME=your-username

# Everything below is optional — the service works out of the box without it.

# GitHub token: switches ingestion from unauthenticated REST (60 req/hr, no
# contributions history) to GraphQL (1 req/hr budget, includes contributions
# and official language colors). Any PAT works; no scopes needed.
# GITHUB_TOKEN=

# Set to require "Authorization: Bearer <key>" on all /api/* routes.
# Leave empty for a fully public API.
# API_SECRET=

# Set to enable POST /api/refresh (manual ingest trigger).
# REFRESH_SECRET=

# PORT=3000
# INTERVAL_HOURS=24
# CORS_ORIGIN=*
# DB_PATH=/data/stats.db
# GITHUB_API_BASE=https://api.github.com
# GITHUB_API_URL=https://api.github.com/graphql
