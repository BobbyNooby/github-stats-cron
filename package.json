{
  "name": "github-stats-cron",
  "version": "0.1.0",
  "description": "Self-hosted GitHub stats snapshotter: daily cron ingests your public GitHub stats into SQLite and exposes a small JSON API.",
  "type": "module",
  "scripts": {
    "dev": "bun run src/index.ts",
    "start": "bun run src/index.ts",
    "ingest": "bun run src/index.ts --ingest-only",
    "mock": "bun run scripts/mock-github.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.3.0",
    "@elysiajs/swagger": "^1.3.1",
    "elysia": "^1.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "^5.6.0"
  }
}
